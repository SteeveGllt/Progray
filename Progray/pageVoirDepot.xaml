<Page x:Class="Progray.pageVoirDepot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="pageVoirDepot" Width="1058">

    <Grid>
        <Grid x:Name="gridModifier" HorizontalAlignment="Left" Height="430" Margin="10,10,0,0" VerticalAlignment="Top" Width="780" Panel.ZIndex="-1" d:IsHidden="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="249*"/>
                <RowDefinition Height="181*"/>
            </Grid.RowDefinitions>
            <Label Content="Délai" HorizontalAlignment="Left" Margin="10,89,0,0" VerticalAlignment="Top" Width="62" FontWeight="Bold" Height="23" Grid.Row="1"/>
            <Button x:Name="btnValide" Content="Modifier" HorizontalAlignment="Left" Margin="651,152,0,0" VerticalAlignment="Top" Width="96" Height="19" Click="btnValide_Click" RenderTransformOrigin="-0.479,-0.211" Grid.Row="1"/>
            <ComboBox x:Name="cbxDelai" HorizontalAlignment="Left" Margin="77,89,0,0" VerticalAlignment="Top" Width="275" Height="23" SelectionChanged="cbxDelai_SelectionChanged" Grid.Row="1"/>
            <TextBox x:Name="tbxProbleme" HorizontalAlignment="Left" Height="130" Margin="116,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="454"/>
            <Label Content="Problème" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" Width="80" FontWeight="Bold"/>
            <Label Content="Tâche(s) :" HorizontalAlignment="Left" Margin="10,182,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxTache" HorizontalAlignment="Left" Height="129" Margin="116,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="454" Grid.RowSpan="2"/>
            <Label Content="N° Série :" HorizontalAlignment="Left" Margin="373,84,0,0" Grid.Row="1" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxNumSerie" HorizontalAlignment="Left" Height="23" Margin="450,84,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        </Grid>
        <Grid x:Name="grid" HorizontalAlignment="Left" Height="430" Margin="10,10,0,0" VerticalAlignment="Top" Width="1038">
            <DataGrid x:Name="dgDepotAll" HorizontalAlignment="Left" Height="308" Margin="10,107,0,-118" VerticalAlignment="Top" Width="565" SelectionChanged="dgDepotAll_SelectionChanged" CanUserAddRows="False"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="640,156,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="640,217,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
            <Label Content="Recherche par Nom :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxRecherche" HorizontalAlignment="Left" Height="23" Margin="136,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="tbxRecherche_TextChanged"/>
            <Label Content="Recherche par Marque :" HorizontalAlignment="Left" Margin="261,10,0,0" VerticalAlignment="Top" Width="146" FontWeight="Bold"/>
            <ComboBox x:Name="cbxMarque" HorizontalAlignment="Left" Margin="412,10,0,0" VerticalAlignment="Top" Width="163" SelectionChanged="cbxMarque_SelectionChanged"/>
            <Label Content="Recherche par Matériel :" HorizontalAlignment="Left" Margin="592,10,0,0" VerticalAlignment="Top" Width="152" FontWeight="Bold"/>
            <ComboBox x:Name="cbxMateriel" HorizontalAlignment="Left" Margin="749,10,0,0" VerticalAlignment="Top" Width="163" SelectionChanged="ComboBox_SelectionChanged"/>
            <Label Content="Recherche par n°série :" HorizontalAlignment="Left" Margin="10,58,0,0" VerticalAlignment="Top" Width="144" FontWeight="Bold"/>
            <TextBox x:Name="tbxRechercheNumSerie" HorizontalAlignment="Left" Height="23" Margin="159,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" TextChanged="tbxRechercheNumSerie_TextChanged"/>
            <Label Content="Recherche par N°Idfentifiant PDF :" HorizontalAlignment="Left" Margin="326,58,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxNumIdentifiant" HorizontalAlignment="Left" Height="23" Margin="557,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="187" TextChanged="tbxNumIdentifiant_TextChanged"/>
            <Label Content="Recherche par ID :" HorizontalAlignment="Left" Margin="749,58,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxRechercheId" HorizontalAlignment="Left" Height="23" Margin="866,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="145" TextChanged="TextBox_TextChanged"/>
        </Grid>

    </Grid>
</Page>
