<Page x:Class="Progray.pageVoirMarque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirMarque">

    <Grid>
        <Grid x:Name="gridMarque" HorizontalAlignment="Left" Height="182" Margin="229,10,0,0" VerticalAlignment="Top" Width="308" Panel.ZIndex="-1">
            <Label Content="Nom de la marque :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbxNomMarque" HorizontalAlignment="Left" Height="23" Margin="130,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Button Content="Valider" HorizontalAlignment="Left" Margin="112,141,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        </Grid>
        <Grid x:Name="grid" HorizontalAlignment="Left" Height="182" Margin="10,10,0,0" VerticalAlignment="Top" Width="780">
            <DataGrid x:Name="dgVoirMarque" HorizontalAlignment="Center" Height="172" VerticalAlignment="Top" Width="154" Margin="160,10,466,0" SelectionChanged="dgVoirMarque_SelectionChanged" CanUserAddRows="False"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="581,49,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="581,104,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
        </Grid>

    </Grid>
</Page>
