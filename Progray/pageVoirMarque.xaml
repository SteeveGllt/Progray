<Page x:Class="Progray.pageVoirMarque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirMarque">

    <Grid>
        <Grid x:Name="gridMarque" HorizontalAlignment="Left" Height="182" Margin="54,10,0,0" VerticalAlignment="Top" Width="712" Panel.ZIndex="-1">
            <Label Content="Nom de la marque :" HorizontalAlignment="Left" Margin="112,30,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxNomMarque" HorizontalAlignment="Left" Height="23" Margin="249,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Button Content="Valider" HorizontalAlignment="Left" Margin="362,126,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
            <Label Content="Modèle :" HorizontalAlignment="Left" Height="28" Margin="168,61,0,0" VerticalAlignment="Top" Width="65" FontWeight="Bold"/>
            <TextBox x:Name="tbxModele" HorizontalAlignment="Left" Height="23" Margin="249,65,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        </Grid>
        <Grid x:Name="grid" HorizontalAlignment="Left" Height="182" Margin="10,10,0,0" VerticalAlignment="Top" Width="780" d:IsHidden="True">
            <DataGrid x:Name="dgVoirMarque" HorizontalAlignment="Center" Height="172" VerticalAlignment="Top" Width="210" Margin="104,10,466,0" SelectionChanged="dgVoirMarque_SelectionChanged" CanUserAddRows="False"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="581,49,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="581,104,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
        </Grid>

    </Grid>
</Page>
