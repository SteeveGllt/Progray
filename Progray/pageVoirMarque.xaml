<Page x:Class="Progray.pageVoirMarque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirMarque">

    <Grid>
        <Grid x:Name="gridMarque" HorizontalAlignment="Left" Height="182" Margin="54,10,0,0" VerticalAlignment="Top" Width="712" Panel.ZIndex="-1" d:IsHidden="True" KeyDown="gridMarque_KeyDown">
            <Label Content="Nom de la marque :" HorizontalAlignment="Left" Margin="112,30,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbxNomMarque" HorizontalAlignment="Left" Height="23" Margin="249,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Button Content="Valider" HorizontalAlignment="Left" Margin="362,126,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        </Grid>
        <Grid x:Name="grid" HorizontalAlignment="Left" Height="277" Margin="10,0,0,0" VerticalAlignment="Top" Width="780">
            <DataGrid x:Name="dgVoirMarque" HorizontalAlignment="Center" Height="172" VerticalAlignment="Top" Width="210" Margin="105,62,465,-52" SelectionChanged="dgVoirMarque_SelectionChanged" CanUserAddRows="False" RenderTransformOrigin="0.467,0.64"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="582,101,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="582,156,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
            <TextBox x:Name="tbxRecherche" HorizontalAlignment="Left" Height="23" Margin="252,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="tbxRecherche_TextChanged"/>
            <Label Content="Recherche :" HorizontalAlignment="Left" Margin="130,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        </Grid>

    </Grid>
</Page>
