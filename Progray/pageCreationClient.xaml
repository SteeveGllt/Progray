<Page x:Class="Progray.pageCreationClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageCreationClient">

    <Grid KeyDown="Grid_KeyDown">
        <Label x:Name="lblTitre" Content="Titre" HorizontalAlignment="Left" Margin="128,13,0,0" VerticalAlignment="Top" Width="37" FontWeight="Bold"/>
        <Label x:Name="lblNom" Content="Nom" HorizontalAlignment="Left" Height="23" Margin="319,13,0,0" VerticalAlignment="Top" Width="37" FontWeight="Bold"/>
        <Label x:Name="lblPrenom" Content="Prénom" HorizontalAlignment="Left" Height="26" Margin="501,13,0,0" VerticalAlignment="Top" Width="56" FontWeight="Bold"/>
        <TextBox x:Name="tbxNom" HorizontalAlignment="Left" Height="23" Margin="286,54,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="121"/>
        <TextBox x:Name="tbxPrenom" HorizontalAlignment="Left" Height="23" Margin="489,54,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114"/>
        <TextBox x:Name="tbxAdresse" HorizontalAlignment="Left" Height="27" Margin="229,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252"/>
        <TextBox x:Name="tbxCp" HorizontalAlignment="Left" Height="23" Margin="173,164,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxVille" HorizontalAlignment="Left" Height="23" Margin="449,164,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxTelephone" HorizontalAlignment="Left" Height="23" Margin="205,218,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxMobile" HorizontalAlignment="Left" Height="23" Margin="501,218,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxMail" HorizontalAlignment="Left" Height="23" Margin="205,270,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="191"/>
        <Label x:Name="lblAdresse" Content="Adresse" HorizontalAlignment="Left" Height="27" Margin="109,108,0,0" VerticalAlignment="Top" Width="88" FontWeight="Bold"/>
        <Label x:Name="lblCp" Content="CP" HorizontalAlignment="Left" Height="28" Margin="109,159,0,0" VerticalAlignment="Top" Width="32" FontWeight="Bold"/>
        <Label x:Name="lblVille" Content="Ville" HorizontalAlignment="Left" Margin="376,161,0,0" VerticalAlignment="Top" Width="73" FontWeight="Bold"/>
        <Label x:Name="lblTelephone" Content="Téléphone" HorizontalAlignment="Left" Margin="109,218,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="lblMobile" Content="Téléphone Mobile" HorizontalAlignment="Left" Margin="377,215,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.473,1.148" FontWeight="Bold"/>
        <Label x:Name="lblMail" Content="Mail" HorizontalAlignment="Left" Margin="109,267,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Rectangle Fill="#FFF5F5F4" HorizontalAlignment="Left" Height="366" Stroke="Black" VerticalAlignment="Top" Width="800" Panel.ZIndex="-2"/>
        <Label Content="Statut" HorizontalAlignment="Left" Margin="425,270,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Button Content="Créer" HorizontalAlignment="Left" Margin="627,330,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        <ComboBox x:Name="cbxTitre" HorizontalAlignment="Left" Margin="109,54,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cbxTitre_SelectionChanged"/>
        <ComboBox x:Name="cbxStatut" HorizontalAlignment="Left" Margin="501,271,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cbxStatut_SelectionChanged"/>

    </Grid>
</Page>
