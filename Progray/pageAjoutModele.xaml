<Page x:Class="Progray.pageAjoutModele"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageAjoutModele">

    <Grid>
        <Label Content="Selectionner la marque :" HorizontalAlignment="Left" Margin="48,84,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <ComboBox x:Name="cbxMarque" HorizontalAlignment="Left" Margin="221,88,0,0" VerticalAlignment="Top" Width="129" SelectionChanged="cbxMarque_SelectionChanged"/>
        <Label Content="Insérer le modèle :" HorizontalAlignment="Left" Margin="80,195,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="tbxModele" HorizontalAlignment="Left" Height="23" Margin="221,198,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Content="Ajouter" HorizontalAlignment="Left" Margin="367,313,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>

    </Grid>
</Page>
