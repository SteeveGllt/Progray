        <Menu x:Name="menu" HorizontalAlignment="Left" Height="57" Margin="0,169,0,0" VerticalAlignment="Top" Width="1241">
            <MenuItem x:Name="gestiondesclients" Header="Gestion de client" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir tous les clients" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click"/>
                <MenuItem Header="Créer un client" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_1"/>
            </MenuItem>
            <MenuItem x:Name="gestiondesmateriels" Header="Gestion des matériels" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir tous les matériels" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_3"/>
