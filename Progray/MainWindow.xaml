                <MenuItem Header="Créer une marque" HorizontalAlignment="Left" Height="76" Width="295" Click="MenuItem_Click_5"/>
            </MenuItem>
            <MenuItem x:Name="gestiondesdepots" Header="Gestion des dépôts" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
