<Window x:Class="Progray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Progray"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1250">
    <Grid x:Name="grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1241*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image x:Name="progray" Margin="536,10,537,555" Source="progray.jpg" Stretch="Fill" RenderTransformOrigin="3.612,1.039"/>
        <Menu x:Name="menu" HorizontalAlignment="Left" Height="57" Margin="0,169,0,0" VerticalAlignment="Top" Width="1241">
            <MenuItem x:Name="gestiondesclients" Header="Gestion de client" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir tous les clients" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click"/>
                <MenuItem Header="Créer un client" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_1"/>
            </MenuItem>
            <MenuItem x:Name="gestiondesmateriels" Header="Gestion des matériels" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir tous les matériels" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_3"/>
                <MenuItem Header="Créer un matériel" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_2"/>
            </MenuItem>
            <MenuItem x:Name="gestiondesmarques" Header="Gestion des marques" Height="57" Width="300" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir toutes les marques" HorizontalAlignment="Left" Height="75" Width="295" Click="MenuItem_Click_4"/>
                <MenuItem Header="Créer une marque" HorizontalAlignment="Left" Height="75" Width="295" Click="MenuItem_Click_5"/>
                <MenuItem Header="Voir les modèles" HorizontalAlignment="Left" Height="76" Width="295" Click="MenuItem_Click_8"/>
            </MenuItem>
            <MenuItem x:Name="gestiondesdepots" Header="Gestion des dépôts" Height="57" Width="341" HorizontalAlignment="Center" FontSize="18">
                <MenuItem Header="Voir tous les dépôts" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_7"/>
                <MenuItem Header="Créer un dépôt" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_6"/>
            </MenuItem>
        </Menu>
        <Frame x:Name="frame" Content="" HorizontalAlignment="Left" Height="485" Margin="10,226,0,0" VerticalAlignment="Top" Width="1222" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
