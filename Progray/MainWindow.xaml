                    <ImageBrush/>
                </Button.Background>
                <Image Height="68" Source="logo-microsoft.png" Stretch="Fill" Width="101" RenderTransformOrigin="0.222,0.48"/>
            </Button>
            <Button x:Name="btnCreerMateriel" HorizontalAlignment="Left" Margin="111.2,187,0,0" VerticalAlignment="Top" Width="104" Click="btnCreerMateriel_Click" Height="101" Grid.Column="1">
