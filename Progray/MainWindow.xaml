                <MenuItem Header="Créer un dépôt" HorizontalAlignment="Left" Height="75" Width="296" Click="MenuItem_Click_6"/>
            </MenuItem>
        </Menu>
        <Frame x:Name="frame" Content="" HorizontalAlignment="Left" Height="485" Margin="10,226,0,0" VerticalAlignment="Top" Width="1222"/>

