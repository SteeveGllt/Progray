            <TextBox x:Name="tbxAdresse" HorizontalAlignment="Left" Height="27" Margin="440,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252"/>
            <TextBox x:Name="tbxCp" HorizontalAlignment="Left" Height="23" Margin="384,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxVille" HorizontalAlignment="Left" Height="23" Margin="660,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxTelephone" HorizontalAlignment="Left" Height="23" Margin="416,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxMobile" HorizontalAlignment="Left" Height="23" Margin="712,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxMail" HorizontalAlignment="Left" Height="23" Margin="416,267,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="191"/>
            <Label x:Name="lblAdresse" Content="Adresse" HorizontalAlignment="Left" Height="27" Margin="320,105,0,0" VerticalAlignment="Top" Width="88" FontWeight="Bold"/>
            <Label x:Name="lblCp" Content="CP" HorizontalAlignment="Left" Height="28" Margin="320,156,0,0" VerticalAlignment="Top" Width="32" FontWeight="Bold"/>
            <Label x:Name="lblVille" Content="Ville" HorizontalAlignment="Left" Margin="587,158,0,0" VerticalAlignment="Top" Width="73" FontWeight="Bold"/>
            <Label x:Name="lblTelephone" Content="Téléphone" HorizontalAlignment="Left" Margin="320,215,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label x:Name="lblMobile" Content="Téléphone Mobile" HorizontalAlignment="Left" Margin="588,212,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.473,1.148" FontWeight="Bold"/>
            <Label x:Name="lblMail" Content="Mail" HorizontalAlignment="Left" Margin="320,264,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Rectangle Fill="#FFF5F5F4" HorizontalAlignment="Left" Height="353" Margin="294,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="631" Panel.ZIndex="-2"/>
            <Button x:Name="btnRetourClient" Content="Retour" HorizontalAlignment="Left" Margin="314,329,0,0" VerticalAlignment="Top" Width="75" Click="btnRetourClient_Click"/>
            <Button x:Name="btnValideClient" Content="Créer" HorizontalAlignment="Left" Margin="837,329,0,0" VerticalAlignment="Top" Width="75" Click="btnValideClient_Click"/>
            <Label Content="Entreprise" HorizontalAlignment="Left" Margin="636,267,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
