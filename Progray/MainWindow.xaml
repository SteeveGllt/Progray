                <Rectangle.Fill>
                    <ImageBrush/>
                </Rectangle.Fill>
            </Rectangle>
            <Label Content="Type de matériel" HorizontalAlignment="Left" Margin="421,209,0,0" VerticalAlignment="Top" Height="30" Width="103" FontWeight="Bold"/>
            <TextBox x:Name="tbxTypeMateriel" HorizontalAlignment="Left" Height="23" Margin="556,216,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
