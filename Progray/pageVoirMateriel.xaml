<Page x:Class="Progray.pageVoirMateriel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirMateriel">

    <Grid>
        <Grid x:Name="gridMateriel" HorizontalAlignment="Left" Height="120" Margin="206,27,0,0" VerticalAlignment="Top" Width="320" Panel.ZIndex="-1" d:IsHidden="True" KeyDown="gridMateriel_KeyDown">
            <Label Content="Type de matériel" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbxType" HorizontalAlignment="Left" Height="23" Margin="140,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Button x:Name="btnValider" Content="Valider" HorizontalAlignment="Left" Margin="232,84,0,0" VerticalAlignment="Top" Width="75" Click="btnValider_Click"/>
        </Grid>
        <Grid x:Name="grid" HorizontalAlignment="Left" Height="300" Margin="10,10,0,0" VerticalAlignment="Top" Width="780">
            <DataGrid x:Name="dgVoirMateriel" HorizontalAlignment="Center" Height="176" VerticalAlignment="Top" Width="183" SelectionChanged="dgVoirMateriel_SelectionChanged" Margin="56,57,541,0" CanUserAddRows="False"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="448,130,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="448,192,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
            <TextBox x:Name="tbxRecherche" HorizontalAlignment="Left" Height="23" Margin="210,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="tbxRecherche_TextChanged"/>
            <Label Content="Rechercher :" HorizontalAlignment="Left" Margin="102,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        </Grid>

    </Grid>
</Page>
