<Page x:Class="Progray.pageVoirClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirClient">

    <Grid x:Name="grid">
        <Grid x:Name="gridMain" HorizontalAlignment="Left" Height="430" Margin="10,10,-69,0" VerticalAlignment="Top" Width="859">
            <DataGrid x:Name="dgClientAll" HorizontalAlignment="Left" Height="174" VerticalAlignment="Top" Width="758" SelectionChanged="dgClientAll_SelectionChanged" CanUserAddRows="False" Margin="0,74,0,0"/>
            <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="797,111,-13,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="797,173,-13,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
            <Label Content="Recherche par nom :" HorizontalAlignment="Left" Margin="44,10,0,0" VerticalAlignment="Top" Width="128" FontWeight="Bold"/>
            <TextBox x:Name="tbxClient" HorizontalAlignment="Left" Height="23" Margin="172,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="142" TextChanged="tbxClient_TextChanged"/>
        </Grid>
        <Grid x:Name="gridModif" HorizontalAlignment="Left" Height="430" VerticalAlignment="Top" Width="800" Margin="0,10,0,0" Panel.ZIndex="-1" d:IsHidden="True" KeyDown="gridModif_KeyDown">
            <Label x:Name="lblTitre" Content="Titre" HorizontalAlignment="Left" Margin="129,30,0,0" VerticalAlignment="Top" Width="82" FontWeight="Bold" Height="26"/>
            <Label x:Name="lblNom" Content="Nom" HorizontalAlignment="Left" Height="23" Margin="316,26,0,0" VerticalAlignment="Top" Width="86" FontWeight="Bold"/>
            <Label x:Name="lblPrenom" Content="Prénom" HorizontalAlignment="Left" Height="26" Margin="493,30,0,0" VerticalAlignment="Top" Width="100" FontWeight="Bold"/>
            <TextBox x:Name="tbxNom" HorizontalAlignment="Left" Height="23" Margin="284,66,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="118"/>
            <TextBox x:Name="tbxPrenom" HorizontalAlignment="Left" Height="23" Margin="482,66,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="112"/>
            <TextBox x:Name="tbxAdresse" HorizontalAlignment="Left" Height="26" Margin="229,119,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="246"/>
            <TextBox x:Name="tbxCp" HorizontalAlignment="Left" Height="23" Margin="174,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
            <TextBox x:Name="tbxVille" HorizontalAlignment="Left" Height="23" Margin="443,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
            <TextBox x:Name="tbxTelephone" HorizontalAlignment="Left" Height="23" Margin="205,227,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
            <TextBox x:Name="tbxMobile" HorizontalAlignment="Left" Height="23" Margin="494,227,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="117"/>
            <TextBox x:Name="tbxMail" HorizontalAlignment="Left" Height="22" Margin="205,278,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="187"/>
            <ComboBox x:Name="cbxStatut" HorizontalAlignment="Left" Margin="494,279,0,0" VerticalAlignment="Top" Width="117" Height="21"/>
            <Label x:Name="lblAdresse" Content="Adresse" HorizontalAlignment="Left" Height="26" Margin="111,119,0,0" VerticalAlignment="Top" Width="86" FontWeight="Bold"/>
            <Label x:Name="lblCp" Content="CP" HorizontalAlignment="Left" Height="28" Margin="111,169,0,0" VerticalAlignment="Top" Width="32" FontWeight="Bold"/>
            <Label x:Name="lblVille" Content="Ville" HorizontalAlignment="Left" Margin="372,171,0,0" VerticalAlignment="Top" Width="71" FontWeight="Bold" Height="26"/>
            <Label x:Name="lblTelephone" Content="Téléphone" HorizontalAlignment="Left" Margin="111,227,0,0" VerticalAlignment="Top" FontWeight="Bold" Height="26" Width="67"/>
            <Label x:Name="lblMobile" Content="Téléphone Mobile" HorizontalAlignment="Left" Margin="373,223,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.473,1.148" FontWeight="Bold" Height="27" Width="116"/>
            <Label x:Name="lblMail" Content="Mail" HorizontalAlignment="Left" Margin="111,275,0,0" VerticalAlignment="Top" FontWeight="Bold" Height="25" Width="35"/>
            <Rectangle Fill="#FFF5F5F4" HorizontalAlignment="Left" Height="354" Stroke="Black" VerticalAlignment="Top" Width="781" Panel.ZIndex="-2" Margin="-1,-1,0,0"/>
            <Label Content="Statut" HorizontalAlignment="Left" Margin="420,278,0,0" VerticalAlignment="Top" FontWeight="Bold" Height="25" Width="43"/>
            <Button Content="Modifier" HorizontalAlignment="Left" Margin="624,320,0,0" VerticalAlignment="Top" Width="73" Click="Button_Click" Height="20"/>
            <ComboBox x:Name="cbxTitre" HorizontalAlignment="Left" Margin="111,68,0,0" VerticalAlignment="Top" Width="118" Height="21"/>
        </Grid>

    </Grid>
</Page>
