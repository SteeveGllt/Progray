<Page x:Class="Progray.pageVoirClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageVoirClient">

    <Grid x:Name="grid">

        <DataGrid x:Name="dgClientAll" HorizontalAlignment="Left" Height="174" VerticalAlignment="Top" Width="574" SelectionChanged="dgClientAll_SelectionChanged"/>
        <Button x:Name="btnModifier" Content="Modifier" HorizontalAlignment="Left" Margin="646,92,0,0" VerticalAlignment="Top" Width="75" Click="btnModifier_Click"/>
        <Button x:Name="btnSupprimer" Content="Supprimer" HorizontalAlignment="Left" Margin="646,154,0,0" VerticalAlignment="Top" Width="75" Click="btnSupprimer_Click"/>
        <Grid x:Name="gridTest" HorizontalAlignment="Left" Height="181" VerticalAlignment="Top" Width="800" Margin="0,179,0,0" d:IsHidden="True">
            <Label x:Name="lblTitre" Content="Titre" HorizontalAlignment="Left" Margin="127,-71,0,0" VerticalAlignment="Top" Width="84" FontWeight="Bold" Height="26"/>
            <Label x:Name="lblNom" Content="Nom" HorizontalAlignment="Left" Height="23" Margin="319,-75,0,0" VerticalAlignment="Top" Width="88" FontWeight="Bold"/>
            <Label x:Name="lblPrenom" Content="Prénom" HorizontalAlignment="Left" Height="26" Margin="500,-71,0,0" VerticalAlignment="Top" Width="102" FontWeight="Bold"/>
            <TextBox x:Name="tbxNom" HorizontalAlignment="Left" Height="23" Margin="286,-35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="121"/>
            <TextBox x:Name="tbxPrenom" HorizontalAlignment="Left" Height="23" Margin="489,-35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="114"/>
            <TextBox x:Name="tbxAdresse" HorizontalAlignment="Left" Height="26" Margin="229,18,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252"/>
            <TextBox x:Name="tbxCp" HorizontalAlignment="Left" Height="23" Margin="173,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxVille" HorizontalAlignment="Left" Height="23" Margin="449,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxTelephone" HorizontalAlignment="Left" Height="23" Margin="205,126,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxMobile" HorizontalAlignment="Left" Height="23" Margin="501,126,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbxMail" HorizontalAlignment="Left" Height="22" Margin="205,177,0,-18" TextWrapping="Wrap" VerticalAlignment="Top" Width="191"/>
            <Label x:Name="lblAdresse" Content="Adresse" HorizontalAlignment="Left" Height="26" Margin="109,18,0,0" VerticalAlignment="Top" Width="88" FontWeight="Bold"/>
            <Label x:Name="lblCp" Content="CP" HorizontalAlignment="Left" Height="28" Margin="109,68,0,0" VerticalAlignment="Top" Width="32" FontWeight="Bold"/>
            <Label x:Name="lblVille" Content="Ville" HorizontalAlignment="Left" Margin="376,70,0,0" VerticalAlignment="Top" Width="73" FontWeight="Bold" Height="26"/>
            <Label x:Name="lblTelephone" Content="Téléphone" HorizontalAlignment="Left" Margin="109,126,0,0" VerticalAlignment="Top" FontWeight="Bold" Height="26"/>
            <Label x:Name="lblMobile" Content="Téléphone Mobile" HorizontalAlignment="Left" Margin="377,122,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.473,1.148" FontWeight="Bold" Height="27"/>
            <Label x:Name="lblMail" Content="Mail" HorizontalAlignment="Left" Margin="109,174,0,-18" VerticalAlignment="Top" FontWeight="Bold" Height="25"/>
            <Rectangle Fill="#FFF5F5F4" HorizontalAlignment="Left" Height="354" Stroke="Black" VerticalAlignment="Top" Width="800" Panel.ZIndex="-2" Margin="0,-88,0,-85"/>
            <Label Content="Statut" HorizontalAlignment="Left" Margin="425,177,0,-21" VerticalAlignment="Top" FontWeight="Bold" Height="25"/>
            <Button Content="Modifier" HorizontalAlignment="Left" Margin="627,235,0,-74" VerticalAlignment="Top" Width="75" Click="Button_Click" Height="20"/>
            <ComboBox x:Name="cbxTitre" HorizontalAlignment="Left" Margin="109,-33,0,0" VerticalAlignment="Top" Width="120" Height="21"/>
            <ComboBox x:Name="cbxStatut" HorizontalAlignment="Left" Margin="501,178,0,-18" VerticalAlignment="Top" Width="120" Height="21"/>
        </Grid>

    </Grid>
</Page>
