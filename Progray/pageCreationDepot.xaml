<Page x:Class="Progray.pageCreationDepot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Progray"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pageCreationDepot">

    <Grid>
        <Grid x:Name="gridDepot" HorizontalAlignment="Left" Height="449" Margin="0,1,0,0" VerticalAlignment="Top" Width="800">
            <Rectangle Fill="#FFF4F4F5" HorizontalAlignment="Left" Height="197" Margin="-1,0,0,0" Stroke="Black" VerticalAlignment="Top" Width="801" Panel.ZIndex="-1"/>
            <Label x:Name="lblMateriel" Content="Matériel" HorizontalAlignment="Left" Margin="278,43,0,0" VerticalAlignment="Top" Width="76" FontWeight="Bold"/>
            <Label x:Name="lblMarque" Content="Marque" HorizontalAlignment="Left" Margin="516,43,0,0" VerticalAlignment="Top" Width="56" FontWeight="Bold"/>
            <Label Content="Délai" HorizontalAlignment="Left" Margin="33,106,0,0" VerticalAlignment="Top" Width="60" FontWeight="Bold"/>
            <ComboBox x:Name="cbxClient" HorizontalAlignment="Left" Margin="107,46,0,0" VerticalAlignment="Top" Width="113" SelectionChanged="cbxClient_SelectionChanged" IsEditable="True"/>
            <ComboBox x:Name="cbxMateriel" HorizontalAlignment="Left" Margin="354,43,0,0" VerticalAlignment="Top" Width="113" SelectionChanged="cbxMateriel_SelectionChanged" IsEditable="True"/>
            <ComboBox x:Name="cbxMarque" HorizontalAlignment="Left" Margin="580,43,0,0" VerticalAlignment="Top" Width="113" SelectionChanged="cbxMarque_SelectionChanged" IsEditable="True"/>
            <ComboBox x:Name="cbxModele" HorizontalAlignment="Left" Margin="580,78,0,0" VerticalAlignment="Top" Width="113" SelectionChanged="cbxModele_SelectionChanged" IsEditable="True"/>
            <ComboBox x:Name="cbxDelai" HorizontalAlignment="Left" Margin="107,114,0,0" VerticalAlignment="Top" Width="233" SelectionChanged="cbxDelai_SelectionChanged"/>
            <TextBox x:Name="tbxNumSerie" HorizontalAlignment="Left" Height="23" Margin="500,109,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193"/>
            <TextBox x:Name="tbxProbleme" HorizontalAlignment="Left" Height="183" Margin="119,211,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="447" AcceptsReturn="True" />
            <Label x:Name="lblClient" Content="Client" HorizontalAlignment="Left" Margin="33,40,0,0" VerticalAlignment="Top" FontWeight="Bold" Width="47"/>
            <Button x:Name="btnValide" Content="Valider le dépôt" HorizontalAlignment="Left" Margin="637,379,0,0" VerticalAlignment="Top" Width="96" Click="Button_Click"/>
            <Rectangle Fill="#FFF4F4F5" HorizontalAlignment="Left" Height="252" Margin="-1,195,0,0" Stroke="Black" VerticalAlignment="Top" Width="801" Panel.ZIndex="-3"/>
            <Label x:Name="lblProbleme" Content="Problème(s)" HorizontalAlignment="Left" Height="28" Margin="27,292,0,0" VerticalAlignment="Top" Width="87" FontWeight="Bold"/>
            <Label Content="N° Série :" HorizontalAlignment="Left" Margin="412,106,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label x:Name="lblModele" Content="Modele" HorizontalAlignment="Left" Margin="516,74,0,0" VerticalAlignment="Top" Width="56" FontWeight="Bold"/>
            <Button Content="Parcourir" HorizontalAlignment="Left" Margin="566,202,0,0" VerticalAlignment="Top" Width="75" Visibility="Hidden"/>
        </Grid>

    </Grid>
</Page>
